rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 驗證輔助函式
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 使用者檔案：僅本人可讀寫
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // 設計放樣專案：登入使用者可讀寫自身專案
    match /projects/{projectId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // 自訂圖塊與填充：登入使用者可讀寫自身項目，未登入者僅能讀取公開範本
    match /customBlocks/{blockId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // 個人 CAD 規格表：登入使用者可讀寫自身項目
    match /cadDnaProfiles/{profileId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Google Search Grounding 實時檢索紀錄
    match /searchGroundingQueries/{queryId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
  }
}
