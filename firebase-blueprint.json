      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "規格表 ID" },
        "userId": { "type": "string", "description": "擁有者 UID" },
        "profileName": { "type": "string", "description": "規格表名稱" },
        "hatchRules": { "type": "array", "description": "剖面填充規則列表" },
        "layerMapping": { "type": "object", "description": "圖層名稱與色碼映射" },
        "updatedAt": { "type": "string", "description": "最後修訂時間" }
