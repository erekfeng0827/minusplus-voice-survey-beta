      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "description": "Google 帳號 Email" },
        "displayName": { "type": "string", "description": "設計師姓名或暱稱" },
        "photoURL": { "type": "string", "description": "Google 頭像 URL" },
        "createdAt": { "type": "string", "description": "註冊時間 (ISO)" },
        "lastLoginAt": { "type": "string", "description": "最後登入時間 (ISO)" }
      },
      "required": ["uid", "email"]
    },
    "projects": {
